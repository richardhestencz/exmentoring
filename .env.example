# Másold le .env néven (a telepítő ezt magától megcsinálja), és ide írd a titkokat.
# A .env SOHA nem kerül fel a GitHubra.

# Port, amin a szerver fut a Mac minin
PORT=3000

# Titkos kulcs az ajtós jelzéshez és a jelenléthez (a telepítő generál egyet)
INGEST_TOKEN=

# Az ajtószenzor nevének részlete (Shelly BLU Door/Window: SBDW-...)
AJTO_NEV=SBDW

# Opcionális: iMessage értesítés erre a számra vagy Apple ID-ra minden nyitáskor/záráskor. Üresen nincs üzenet.
UZENET=

# Opcionális: ebédidős tipp (11-13 óra) ezekkel a nevekkel, vesszővel elválasztva. Üresen nincs tipp.
EBED_NEVEK=
